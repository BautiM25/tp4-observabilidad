      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (ruta) (rate(http_requests_total[1m]))",
          "legendFormat": "{{ruta}}",
          "refId": "A"
